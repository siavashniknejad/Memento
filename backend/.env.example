# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub — .gitignore already excludes it.

OPENAI_API_KEY=sk-your-real-key-here
PORT=3000

# Postgres connection
PGHOST=localhost
PGPORT=5432
PGUSER=siamind_app
PGPASSWORD=your-db-password-here
PGDATABASE=memento

# Used to sign login tokens (JWT). Generate a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
